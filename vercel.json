{
  "rewrites": [
    { "source": "/app/(.*)", "destination": "/index.html" },
    {
      "source": "/register/",
      "destination": "http://170.64.220.153:8000/register/",
      "headers": {
        "Host": "{host}"
      }
    },
    {
      "source": "/register",
      "destination": "http://170.64.220.153:8000/register/",
      "headers": {
        "Host": "{host}"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": "http://170.64.220.153:8000/api/$1",
      "headers": {
        "Host": "{host}"
      }
    },
    {
      "source": "/media/(.*)",
      "destination": "http://170.64.220.153:8000/media/$1",
      "headers": {
        "Host": "{host}"
      }
    },
    {
      "source": "/static/(.*)",
      "destination": "http://170.64.220.153:8000/static/$1",
      "headers": {
        "Host": "{host}"
      }
    },
    { "source": "/", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}