{
  "rewrites": [
    {
      "source": "/app/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/register/",
      "destination": "http://170.64.220.153/register/"
    },
    {
      "source": "/register",
      "destination": "http://170.64.220.153/register/"
    },
    {
      "source": "/api/(.*)",
      "destination": "http://170.64.220.153/api/$1"
    },
    {
      "source": "/media/(.*)",
      "destination": "http://170.64.220.153/media/$1"
    },
    {
      "source": "/static/(.*)",
      "destination": "http://170.64.220.153/static/$1"
    },
    {
