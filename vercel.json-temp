{
  "rewrites": [
    {
      "source": "/app/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/register/",
      "destination": "https://170.64.220.153/register/"
    },
    {
      "source": "/register",
      "destination": "https://170.64.220.153/register/"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://170.64.220.153/api/$1"
    },
    {
      "source": "/media/(.*)",
      "destination": "https://170.64.220.153/media/$1"
    },
    {
      "source": "/static/(.*)",
      "destination": "https://170.64.220.153/static/$1"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}